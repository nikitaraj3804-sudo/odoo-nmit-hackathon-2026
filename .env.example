# =============================================================================
# Dayflow HRMS - Environment Variables Template (.env.example)
# Tagline: "Every workday, perfectly aligned."
# Hackathon: odoo-nmit-hackathon-2026
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Flask Core Settings
# -----------------------------------------------------------------------------
FLASK_APP=backend/app.py
FLASK_ENV=production
FLASK_DEBUG=0
PORT=5005
SECRET_KEY=change_this_to_a_secure_random_production_secret_key

# -----------------------------------------------------------------------------
# 2. Database Connection Variables
# Standard local names (DB_*) and Railway auto-injected names (MYSQL*) supported.
# -----------------------------------------------------------------------------
# Railway Auto-Injected Plugin Variables:
# MYSQLHOST=containers-us-west-xxx.railway.app
# MYSQLPORT=3306
# MYSQLUSER=root
# MYSQLPASSWORD=your_railway_password
# MYSQLDATABASE=railway
# MYSQL_URL=mysql://root:password@host:port/railway

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=password
DB_NAME=dayflow_hrms

# Optional direct connection string override:
SQLALCHEMY_DATABASE_URI=mysql+pymysql://root:password@localhost:3306/dayflow_hrms

# -----------------------------------------------------------------------------
# 3. Security & JWT Settings
# -----------------------------------------------------------------------------
JWT_SECRET_KEY=change_this_to_a_secure_jwt_signing_key_2026
JWT_ACCESS_TOKEN_EXPIRES_HOURS=24

# -----------------------------------------------------------------------------
# 4. CORS Origins (Comma-separated allowed origins or wildcard '*')
# In production, set this to your frontend domain (e.g. https://your-app.netlify.app)
# -----------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,https://your-app.up.railway.app
